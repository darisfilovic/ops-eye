# Copy to .env and adjust. .env is ignored by git.

TZ=Europe/Sarajevo
# Interface language of the status page: en (English) or bs (Bosnian)
OPS_LANG=en

# Where Nginx Proxy Manager writes its access logs (proxy-host-*_access.log)
NPM_LOGS_DIR=/srv/npm/data/logs
# Addresses to leave out of the traffic report (your own IP), comma separated
EXCLUDE_IPS=127.0.0.1

# Local ports. Everything binds to 127.0.0.1 only; open them with an SSH tunnel.
OPS_STATUS_PORT=8092
OPS_GOACCESS_PORT=7880
OPS_BESZEL_PORT=8090
OPS_F2B_PORT=8091
OPS_PORTAINER_PORT=9000

# Beszel agent registration. Both values come from the hub UI
# (Settings > Tokens for the universal token, Add System for the key).
BESZEL_KEY=
BESZEL_TOKEN=

# Application checks for the status page (Odoo behind Docker Compose)
ODOO_WEB_CONTAINER=odoo-web-1
ODOO_DB_CONTAINER=odoo-db-1
ODOO_DB_USER=odoo
# Databases with scheduled jobs, comma separated (same list as db_name in odoo.conf)
ODOO_DATABASES=production,staging
# Weekly cleanup: remove filestore directories of dropped databases.
# Off by default; the cleanup only lists them until this is yes.
CLEAN_ORPHAN_FILESTORE=no
# Odoo log file on the host, for the 24 h error count (leave empty to skip)
ODOO_LOG=/srv/odoo/logs/odoo.log
# Public hostnames to probe for HTTP status and certificate expiry, comma separated
DOMAINS=erp.example.com,staging.example.com
# Registered domains to check for expiry with whois, comma separated
REGISTERED_DOMAINS=example.com

# Optional: MaxMind GeoLite2 updates (docker compose --profile geoip up -d)
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=
